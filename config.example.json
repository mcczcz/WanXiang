{
  // 原版生存服默认配置：保留原版玩法，开启经验球合并和保守的超量清理。
  // 配置格式版本。通常不要手动修改；缺少字段会在启动时自动补回。
  "version": 22,

  // 日志等级：-1=关闭，0=Fatal，1=Error，2=Warn，3=Info，4=Debug，5=Trace。
  "logLevel": 3,
  // 翻译文件名，不含 .json。随包提供 zh_CN 和 en_US。
  "language": "zh_CN",

  // 将玩家皮肤标记为可信任皮肤。
  "trustedSkinEnable": true,
  // 钓鱼成功后自动收杆并重新抛竿。
  "autoFishingEnable": false,
  // 注册原版 /ability 命令。
  "abilityCommandEnable": true,
  // 注册 /mspt 命令，供玩家查看当前 MSPT 和 TPS。
  "msptCommandEnable": true,
  // 区块加载时清理无法识别的方块。操作不可恢复。
  "cleanUnknownBlocksEnable": false,
  // 向非管理员隐藏客户端显示的 OP 权限信息。
  "hideOpPermissionEnable": true,

  // 修改掉落物存在时间。只影响启用后新生成的掉落物。
  "droppedItemLifetime": {
    "enable": false,
    // 未单独列出的物品使用此时间，单位为秒。
    "defaultSeconds": 300,
    // 按完整物品标识覆盖时间，例如 minecraft:diamond。
    "items": {
      // "minecraft:diamond": 600,
      // "minecraft:nether_star": 1800
    }
  },

  // 合并同一维度内指定半径范围的经验球。
  "xpOrbMerge": {
    "enable": true,
    "radius": 8.0,
    // 检查间隔，单位为游戏刻；20 刻约等于 1 秒。
    "intervalTicks": 20
  },

  // 阻止状态效果触发的附带行为。
  "mobEffectBlocker": {
    "enable": false,
    "weaving": true,
    "infested": true,
    "oozing": true,
    "windCharged": false
  },

  // 原木或树叶被破坏后，加速清理无支撑的非持久树叶。
  "fastLeafDecay": {
    "enable": false,
    // 每片树叶随机延迟检查的最小/最大游戏刻。
    "minDelayTicks": 2,
    "maxDelayTicks": 8
  },

  // 服务器启动时清理世界数据库中的未加载实体记录，仅执行一次。
  // entityTypeNamesToClean 为空表示清理全部未加载实体，操作不可恢复。
  "unloadedEntitiesCleaner": {
    "enable": false,
    "entityTypeNamesToClean": [],
    "logCleanedEntityTypeCounts": true,
    "logSkippedEntityTypeCounts": true,
    "writeCleanupResultToTextLog": false,
    "cleanupResultTextLogFile": "cleanup-result.log"
  },

  // 按 Cron 表达式执行服务端命令。Cron 为 6 段：秒 分 时 月内日期 月 星期。
  "scheduledCommands": {
    "enable": false,
    // 任务中的 command 不要带开头的 /；命令以服务端 Owner 权限执行。
    "tasks": []
  },

  // 覆盖命令注册时的权限等级。修改后需要重启服务器。
  "commandPermissions": {
    "enable": false,
    // 规则的 permissionLevel 可选：Any、GameDirectors、Admin、Host、Owner、Internal。
    "rules": []
  },

  // 修改客户端服务器列表中显示的 MOTD 和人数。
  "serverPong": {
    "enable": false,
    "motdEnable": false,
    "motd": "",
    "playerCountEnable": false,
    "playerCount": 0,
    "maxPlayerCountEnable": false,
    "maxPlayerCount": 0
  },

  // 修改客户端进入世界时显示的存档名称，不会修改世界实际名称。
  "clientLevelName": {
    "enable": false,
    "name": ""
  },

  // 资源包共存：服务器材质包和玩家自己启用的材质包同时生效。
  // 原版把「必须下载服务器材质包」和「进服后禁用玩家自己的材质包」绑在一起，
  // 下面三个开关分别对应拆开它所需要改的封包字段，通常保持默认即可。
  "coResourcePack": {
    "enable": false,
    // 让客户端必须下载服务器的材质包（覆盖 server.properties 的 texturepack-required）。
    "forceRequired": true,
    // 把服务器下发的包标记为附带内容，而不是玩家自选的材质包。
    "markAsAddonPack": true,
    // 不再因为「世界要求材质包」而踢掉玩家自己启用的材质包。
    "allowClientPacks": true
  },

  // 生存服默认仅在经验球/箭矢超量时清理；保留掉落物、怪物和玩家附近实体。
  "entityCleaner": {
    "enable": true,
    // true 只统计并记录日志，不实际删除实体。
    "dryRun": false,
    "schedule": {
      "enable": false,
      "cron": "0 */10 * * * *"
    },
    "threshold": {
      "enable": true,
      // 候选实体数超过此值时触发阈值清理。
      "maxEntities": 1000,
      // 阈值清理后最多保留的候选实体数。
      "targetEntities": 500,
      "checkIntervalTicks": 100,
      "cooldownSeconds": 300,
      // 最近一次服务端 tick 耗时超过此值（单位：毫秒）时触发阈值清理；0 表示关闭。
      "maxMspt": 0.0
    },
    "droppedItem": {
      // age 从 6000 向下递减；大于此值时视为刚生成并予以保护。0 表示关闭。
      "protectAboveAge": 5900,
      // 贵重物品白名单；匹配完整物品标识的掉落物始终保留。
      "whitelist": [
        "minecraft:netherite_helmet", "minecraft:netherite_sword", "minecraft:netherite_chestplate",
        "minecraft:diamond_helmet", "minecraft:netherite_leggings", "minecraft:undyed_shulker_box",
        "minecraft:netherite_boots", "minecraft:shulker_box", "minecraft:elytra",
        "minecraft:dragon_egg", "minecraft:nether_star", "minecraft:diamond_sword",
        "minecraft:diamond_chestplate", "minecraft:diamond_boots", "minecraft:diamond_leggings",
        "minecraft:diamond_hoe", "minecraft:netherite_hoe", "minecraft:diamond_axe",
        "minecraft:netherite_axe", "minecraft:netherite_pickaxe", "minecraft:diamond_pickaxe"
      ]
    },
    "filter": {
      // whitelist=只清理名单内类型/family；blacklist=名单内受保护，其余清理。
      "mode": "whitelist",
      // 不包含 minecraft:item 或 monster，保留死亡掉落物和生存农场中的生物。
      "typeNames": ["minecraft:xp_orb", "minecraft:arrow"],
      "families": []
    },
    "protection": {
      // 下面的布尔值为 true 时启用对应保护，设为 false 后实体仍需通过名单和其他保护检查才可能被清理。
      // 命名保护：实体的名称标签不为空时跳过清理。玩家无论如何都会跳过。
      "named": true,
      // 驯服保护：跳过已驯服的动物或坐骑，例如狼、猫、鹦鹉和马。
      "tamed": true,
      // 拴绳保护：跳过当前被拴绳连接的实体。
      "leashed": true,
      // 载具/乘客保护：实体载有乘客，或实体正在骑乘另一个实体时跳过。
      "vehicles": true,
      // 持久化保护：跳过带有持久化标记、不会自然消失的实体；刷怪蛋或召唤命令生成的生物通常也带此标记。
      // 如果希望清理这类苦力怕等实体，请设为 false，或在 /entitycleaner 的确认表单中取消勾选对应保留项。
      "persistent": true,
      // 村民保护：跳过 Villager、VillagerV2 和 WanderingTrader。
      "villagers": true,
      // 建造物保护：跳过盔甲架、画、末影水晶、NPC、拴绳结，以及所有矿车和船的变体。
      "builds": true,
      // Boss 保护：跳过末影龙和凋灵。
      "bosses": true,
      // 下落方块保护：跳过正在下落的沙子、砂砾、铁砧等 FallingBlock 实体。
      "fallingBlocks": true,
      // 移动方块保护：跳过活塞推动中的 MovingBlock 实体。
      "movingBlocks": true,
      // 鱼钩保护：跳过 FishingHook；关闭后可能影响自动钓鱼和正常钓鱼。
      "fishingHooks": true,
      // 不祥之瓶生成器保护：跳过试炼密室的不祥之瓶战利品生成器。
      "ominousItemSpawners": true,
      // 玩家距离保护：同一维度内距最近玩家小于此格数的实体跳过；0 或负数表示关闭。
      "playerRadius": 32.0
    },
    "warning": {
      "enable": true,
      // 清理前广播的倒计时秒数；空数组表示触发即清理。
      "secondsBefore": [15],
      // 空字符串使用当前语言的默认提示；{seconds} 为剩余秒数，支持 § 颜色代码。
      "message": "",
      // 是否向全服广播实际清理结果；不受上面的预告 enable 开关影响。
      "broadcastResult": true,
      // {count} 为实际清理数量；空字符串使用当前语言的默认提示。
      "resultMessage": ""
    },
    // 是否在日志中输出按实体类型分组的删除统计。
    "logResult": true
  },

  // 爆炸控制。规则按顺序应用；可选覆盖字段为 null 时保持原版值。
  "explosionControl": {
    "enable": false,
    // 规则的 sourceType 使用 * 匹配所有来源、<none> 匹配没有实体来源的爆炸。
    "rules": []
  },

  // 生物方块破坏控制。用于禁止凋灵和掠夺兽破坏方块。
  "mobBlockDestruction": {
    "enable": false,
    "wither": true,
    "ravager": true
  }
}
