{
  // 原版生存服默认配置：保留原版玩法，开启经验球合并和保守的超量清理。
  "version": 24,
  // 日志等级：-1=Off, 0=Fatal, 1=Error, 2=Warn, 3=Info, 4=Debug, 5=Trace。
  "logLevel": 3,
  // 语言代码 (如 zh_CN, en_US)。
  "language": "zh_CN",
  "trustedSkinEnable": true,
  "autoFishingEnable": false,
  "autoReplenishEnable": true,
  "abilityCommandEnable": true,
  "msptCommandEnable": true,
  // 启用 /vanish 隐身 (仅 OP)。修改后 /wanxiang reload 生效。
  "vanishEnable": true,
  "cleanUnknownBlocksEnable": false,
  "hideOpPermissionEnable": true,
  "clientAchievementsEnable": false,
  // 侧边栏：/sidebar on|off 切换，/wanxiang reload 重载。支持 Placeholder 占位符。
  "sidebar": {
    "enable": false,
    "defaultSidebarStatus": true, // 新玩家默认开启
    "updateInterval": 1000, // 刷新间隔 (ms)，最小 50ms
    "dynamicTitles": [
      "§b万象"
    ], // 标题组 (支持 Placeholder)
    "dynamicLines": [
      [
        "§f欢迎来到服务器"
      ]
    ], // 行组 (支持 Placeholder)
    "currentLineGroupIndex": 0,
    "lineGroupSwitchInterval": 5000 // 轮播间隔 (ms)
  },
  // 自定义击退倍率 (1.0 为原版，0 为不改变速度，2 为两倍速度变化)。需重载。
  "customKnockback": {
    "enable": false,
    "player": {
      "horizontal": 1.0,
      "vertical": 1.0
    },
    "mob": {
      "horizontal": 1.0,
      "vertical": 1.0
    }
  },
  // 掉落物存活时间 (秒)。只影响新生成的掉落物。
  "droppedItemLifetime": {
    "enable": false,
    "defaultSeconds": 300,
    // 精确 ID 优先。/正则表达式/ 匹配完整物品 ID，多条正则命中时按键名字典序取第一条。
    "items": {} // 示例: { "minecraft:diamond_sword": 600, "/minecraft:.*_sword/": 180 }
  },
  // 合并范围内经验球。
  "xpOrbMerge": {
    "enable": true,
    "radius": 8.0, // 合并半径
    "intervalTicks": 20 // 检测间隔 (20 tick ≈ 1s)
  },
  // 阻止特定状态效果触发的附带行为 (受伤/死亡)。
  "mobEffectBlocker": {
    "enable": false,
    "weaving": true,
    "infested": true,
    "oozing": true,
    "windCharged": false
  },
  // 加速无支撑树叶腐烂。
  "fastLeafDecay": {
    "enable": false,
    "minDelayTicks": 2,
    "maxDelayTicks": 8
  },
  // 开服时清理一次未加载实体。慎用 (不可恢复)。
  "unloadedEntitiesCleaner": {
    "enable": false,
    "entityTypeNamesToClean": [],
    "logCleanedEntityTypeCounts": true,
    "logSkippedEntityTypeCounts": true,
    "writeCleanupResultToTextLog": false,
    "cleanupResultTextLogFile": "cleanup-result.log"
  },
  // 定时命令。6 段 Cron：秒 分 时 日 月 星期。
  "scheduledCommands": {
    "enable": false,
    "tasks": [] // 例: { "cron": "0 */5 * * * *", "command": "list", "outputToConsole": true }
  },
  // 命令权限覆盖 (需重启生效)。
  "commandPermissions": {
    "enable": false,
    "rules": [] // 例: { "command": "stop", "permissionLevel": "Admin" }
  },
  // 自定义服务器列表显示。
  "serverPong": {
    "enable": false,
    "motdEnable": false,
    "motd": "",
    "playerCountEnable": false,
    "playerCount": 0,
    "maxPlayerCountEnable": false,
    "maxPlayerCount": 0
  },
  // 客户端显示存档名。
  "clientLevelName": {
    "enable": false,
    "name": ""
  },
  // 资源包共存：拆分进服协议中的资源包选项，允许客户端使用自选包。
  "coResourcePack": {
    "enable": false,
    "forceRequired": true, // 强制下载
    "markAsAddonPack": true, // 标记为扩展包
    "allowClientPacks": true // 允许客户端使用自选包
  },
  // 实体清理：定时或超量触发。支持保护名单、预告与手动清理面板 (/eclean)。
  "entityCleaner": {
    "enable": true,
    "dryRun": false, // true 时仅统计不实际删除
    "schedule": {
      "enable": false,
      "cron": "0 */10 * * * *"
    },
    "threshold": {
      "enable": true,
      "maxEntities": 1000, // 触发阈值
      "targetEntities": 500, // 目标保留数
      "checkIntervalTicks": 100,
      "cooldownSeconds": 300, // 两次清理间隔 (s)
      "maxMspt": 0.0 // 高延迟触发阈值 (0=关闭)
    },
    "droppedItem": {
      "protectAboveAge": 5900, // 年龄保护 (倒计数, 0=关)
      "whitelist": [
        "minecraft:netherite_helmet",
        "minecraft:netherite_sword",
        "minecraft:netherite_chestplate",
        "minecraft:diamond_helmet",
        "minecraft:netherite_leggings",
        "minecraft:undyed_shulker_box",
        "minecraft:netherite_boots",
        "minecraft:shulker_box",
        "minecraft:elytra",
        "minecraft:dragon_egg",
        "minecraft:nether_star",
        "minecraft:diamond_sword",
        "minecraft:diamond_chestplate",
        "minecraft:diamond_boots",
        "minecraft:diamond_leggings",
        "minecraft:diamond_hoe",
        "minecraft:netherite_hoe",
        "minecraft:diamond_axe",
        "minecraft:netherite_axe",
        "minecraft:netherite_pickaxe",
        "minecraft:diamond_pickaxe"
      ]
    },
    "filter": {
      "mode": "whitelist", // 模式：whitelist(仅清名单内)/blacklist(保护名单内)
      "typeNames": [
        "minecraft:xp_orb",
        "minecraft:arrow"
      ],
      "families": []
    },
    "protection": {
      "named": true, // 命名实体
      "tamed": true, // 已驯服生物
      "leashed": true, // 拴绳生物
      "vehicles": true, // 载具/骑乘实体
      "persistent": true, // 持久化生物
      "villagers": true, // 村民
      "builds": true, // 建筑实体 (盔甲架/画/矿车等)
      "bosses": true, // Boss
      "fallingBlocks": true, // 下落方块
      "movingBlocks": true, // 活塞移动中方块
      "fishingHooks": true, // 鱼钩
      "ominousItemSpawners": true,
      "playerRadius": 32.0 // 保护玩家 32 格内实体
    },
    "warning": {
      "enable": true,
      "secondsBefore": [
        15
      ], // 预告秒数
      "message": "", // {seconds} 占位符
      "broadcastResult": true,
      "resultMessage": "" // {count} 占位符
    },
    "logResult": true
  },
  // 爆炸控制 (规则按顺序应用)。
  "explosionControl": {
    "enable": false,
    "rules": [] // sourceType: * 匹配所有, <none> 无实体来源
  },
  // 活塞控制：自定义规则需重启生效。
  "pistonControl": {
    "enable": false,
    // 方块ID -> { movementType(0-3), stickyType(0-1) }
    "customPistonBlocks": {},
    "pistonImmuneEntities": [] // 免疫列表 (["*"] 匹配所有)
  },
  // 生物方块破坏控制。
  "mobBlockDestruction": {
    "enable": false,
    "wither": true,
    "ravager": true
  }
}
